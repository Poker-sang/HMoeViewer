<Window
    x:Class="HMoeViewer.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:HMoeViewer.Core"
    xmlns:pages="using:HMoeViewer.Pages"
    x:DataType="core:MainViewModel"
    Title="HMoeViewer"
    Width="1200"
    Height="800"
    MinWidth="760"
    MinHeight="480"
    Icon="avares://HMoeViewer/Assets/logo.jpg">
    <Window.KeyBindings>
        <KeyBinding Command="{Binding SaveCommand}" Gesture="Ctrl+S" />
        <KeyBinding Command="{Binding UndoCommand}" Gesture="Ctrl+Z" />
        <KeyBinding Command="{Binding RedoCommand}" Gesture="Ctrl+Y" />
    </Window.KeyBindings>
    <DockPanel Margin="8" VerticalSpacing="{StaticResource SpacingMedium}">
        <StackPanel DockPanel.Dock="Bottom" Spacing="{StaticResource SpacingSmall}">
            <TextBlock
                MaxLines="1"
                Text="{Binding Status}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap">
                <ToolTip.Tip>
                    <TextBlock MaxWidth="720" Text="{Binding Status}" TextWrapping="Wrap" />
                </ToolTip.Tip>
            </TextBlock>
            <ProgressBar
                Height="3"
                IsIndeterminate="True"
                IsVisible="{Binding IsBusy}" />
        </StackPanel>
        <PageNavigationHost>
            <!-- The page host presents the page as its data; keep all tabs bound to the window view model. -->
            <TabbedPage
                DataContext="{Binding $parent[Window].DataContext}"
                SelectedIndex="0"
                TabPlacement="Top">
                <pages:BrowsePage />
                <pages:UndoHistoryPage />
                <pages:SettingsPage />
            </TabbedPage>
        </PageNavigationHost>
    </DockPanel>
</Window>
